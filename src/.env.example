APP_NAME=EcoData
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=America/Bogota

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=EcoData_db
DB_USERNAME=laravel
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
REDIS_QUEUE_RETRY_AFTER=180
REDIS_HOST=redis
REDIS_PORT=6379
FILESYSTEM_DISK=local

# Use log locally. Configure SMTP before inviting real users.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_FROM_ADDRESS=notificaciones@example.invalid
MAIL_FROM_NAME="${APP_NAME}"

AUTH_REGISTRATION_ENABLED=false
ECODATA_ALLOW_DEMO_SEED=false
