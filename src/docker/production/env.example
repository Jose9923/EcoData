# Copy to a private location OUTSIDE the repository, mode 0600.
# Prefer create-env.py; no production secret belongs in Git or the Docker context.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://ecodata.varcor.tech
APP_KEY=
APP_TIMEZONE=America/Bogota
ECODATA_IMAGE_TAG=production
ECODATA_SECRETS_DIR=/opt/ecodata/private/secrets

DB_DATABASE=ecodata_production
DB_USERNAME=ecodata_app
DB_PASSWORD=
DB_MIGRATOR_USERNAME=ecodata_migrator
DB_MIGRATOR_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Deferred: array does not deliver email and does not log activation/reset links.
MAIL_MAILER=array
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=notificaciones@example.invalid

# These security settings are also enforced in compose.production.yaml.
SESSION_SECURE_COOKIE=true
AUTH_REGISTRATION_ENABLED=false
ECODATA_ALLOW_DEMO_SEED=false
